{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["assets/**/*.js", "app/**/*.js", "admin/**/*.js"],
  "exclude": ["dist", "node_modules"]
}
